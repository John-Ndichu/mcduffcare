# Hoist all packages so Next.js can resolve them
shamefully-hoist=true

# Required for workspace: protocol on Windows
link-workspace-packages=true

# Avoid symlink issues on Windows NTFS
prefer-symlinked-executables=false

# Strict peer deps - set to false to avoid noise during initial install
strict-peer-dependencies=false

# Auto-install peer dependencies
auto-install-peers=true

# Increase Node.js heap size for large builds on Windows
